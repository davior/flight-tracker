LIVE_FLIGHT_PROVIDER=opensky
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret
ADSBX_API_KEY=your-api-key
ADSBX_API_BASE_URL=https://adsbexchange.com/api/aircraft

# Authentication (required)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret

# The public URL of the frontend (used in email verification and reset links)
APP_BASE_URL=http://localhost:5173

# Email / SMTP — connects to the shared production mail server
# If these are unset, verification/reset links are printed to the backend console instead.
# Alternative for fully offline dev: Mailpit (axllent/mailpit image) on port 1025.
SMTP_HOST=mail.chemtrail-tracker.com
SMTP_PORT=587
SMTP_USERNAME=accounts@chemtrail-tracker.com
SMTP_PASSWORD=your-mail-password
SMTP_FROM_EMAIL=accounts@chemtrail-tracker.com

# Google OAuth (optional — if not set, the "Continue with Google" button is hidden)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Frontend env var (must also be set for Vite builds)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
