LIVE_FLIGHT_PROVIDER=opensky
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret
ADSBX_API_KEY=your-api-key
ADSBX_API_BASE_URL=https://adsbexchange.com/api/aircraft

# Authentication (required)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret

# The public URL of the frontend (used in email verification and reset links)
APP_BASE_URL=http://localhost:5173

# Email / SMTP (optional — if not set, links are logged to the backend console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourapp.com

# Google OAuth (optional — if not set, the "Continue with Google" button is hidden)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Frontend env var (must also be set for Vite builds)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
