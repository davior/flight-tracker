LIVE_FLIGHT_PROVIDER=opensky
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret
ADSBX_API_KEY=your-api-key
ADSBX_API_BASE_URL=https://adsbexchange.com/api/aircraft

# Authentication (required)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret

# The public URL of the frontend (used in email verification and reset links)
APP_BASE_URL=http://localhost:5173

# =============================================================================
# SMTP2GO.com for outbound.
# For inbound forwarding (accounts@ → your personal inbox) use ImprovMX (free):
# https://improvmx.com — add their MX records and configure forwarding rules.
# =============================================================================
SMTP_HOST=mail-au.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=chemtrail-tracker.com
SMTP_PASSWORD=<smtp2go.com_USER_PASSWORD>
SMTP_FROM_EMAIL=accounts@chemtrail-tracker.com

# Google OAuth (optional — if not set, the "Continue with Google" button is hidden)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Frontend env var (must also be set for Vite builds)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Logging
# LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
# LOG_FILE=logs/flight-tracker.log   # omit to disable file logging (console only)
# LOG_MAX_BYTES=10485760  # rotate when file exceeds this size in bytes (default: 10 MB)
# LOG_BACKUP_COUNT=5      # number of archived log files to keep (default: 5)
