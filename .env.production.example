# =============================================================================
# Chemtrail Tracker (Flight Tracker) — Production Environment
# Copy this file to .env and fill in your values before running deploy.sh
# =============================================================================

# =============================================================================
# Database credentials
# =============================================================================
MYSQL_ROOT_PASSWORD=change-me-strong-root-password
MYSQL_PASSWORD=change-me-strong-db-password

# =============================================================================
# Authentication
# =============================================================================
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=30

# =============================================================================
# Live flight data provider — choose one
# =============================================================================
LIVE_FLIGHT_PROVIDER=opensky

# OpenSky Network (https://opensky-network.org — create an account for credentials)
OPENSKY_CLIENT_ID=your-opensky-client-id
OPENSKY_CLIENT_SECRET=your-opensky-client-secret

# ADS-B Exchange (uncomment and set LIVE_FLIGHT_PROVIDER=adsbx to use instead)
# ADSBX_API_KEY=your-adsbx-api-key

# =============================================================================
# Application URL (used in email verification / password-reset links)
# =============================================================================
APP_BASE_URL=https://yourdomain.com

# =============================================================================
# SMTP2GO.com for outbound.
# For inbound forwarding (accounts@ → your personal inbox) use ImprovMX (free):
# https://improvmx.com — add their MX records and configure forwarding rules.
# =============================================================================
SMTP_HOST=mail-au.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=chemtrail-tracker.com
SMTP_PASSWORD=<YOUR_SMTP2GO.COM_USER_PASSWORD>
SMTP_FROM_EMAIL=accounts@chemtrail-tracker.com

# =============================================================================
# Google OAuth (optional — enables "Continue with Google" login)
# Requires rebuild after changing: ./scripts/deploy.sh
# =============================================================================
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/flight-tracker.log
# LOG_MAX_BYTES=10485760  # 10 MB — rotate when file exceeds this size
# LOG_BACKUP_COUNT=5      # number of archived log files to keep

# =============================================================================
# Admin section
# =============================================================================
# Admin user is seeded automatically on first startup if it doesn't exist yet.
ADMIN_EMAIL=admin@chemtrail-tracker.com
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# AI Analysis — DeepSeek by default. Leave AI_API_KEY unset to disable AI features.
# For Ollama (local): AI_PROVIDER=ollama, AI_BASE_URL=http://localhost:11434/v1, AI_API_KEY=ollama
# For OpenAI:         AI_PROVIDER=openai, AI_BASE_URL= (leave blank), AI_API_KEY=sk-...
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_API_KEY=your-deepseek-api-key
# AI_BASE_URL=https://api.deepseek.com/v1

# Threat detection / auto-blocking
# AUTO_BLOCK_REQUESTS_PER_MINUTE=300   # IPs exceeding this rate are auto-blocked
# AUTO_BLOCK_RELEASE_HOURS=24          # auto-blocked IPs are released after this many hours
