{$DOMAIN} {
    encode gzip
    root * /srv/web
    try_files {path} /index.html
    file_server
}

www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

app.{$DOMAIN} {
    encode gzip

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:8000
    }

    handle /photos/* {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv/app
        try_files {path} /index.html
        file_server
    }
}
